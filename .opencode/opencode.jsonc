{

// "oh-my-opencode@3.2.1",
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    
    "opencode-pty",
    "opencode-antigravity-auth@1.4.6"
  ],
  "model": "llama/nemotron-v3-coder",
  "default_agent": "unified-orchestrator",
  "tools": {
    "write": true,
    "bash": true
  },
  "experimental": {
    //   "continue_loop_on_deny": true,
    //   "batch_tool": true,
    //   "disable_paste_summary": false,
    //   "primary_tools": [],
    //   "mcp_timeout": 1000000000000000,
    //   "openTelemetry": true,
  },
  "instructions": [
    "/home/bamer/.config/opencode/instructionsELF/*.md"
  ],
  "agent": {
    "plan": {
      "temperature": 0.7
    },
    "build": {
      "mode": "primary",
      "temperature": 1,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  },
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama",
      "options": {
        "baseURL": "http://127.0.0.1:12134/v1"
      },
      "models": {
        "nemotron-v3-coder": {
          "name": "nemotron-v3-coder",
          "limit": {
            "context": 100000,
            "output": 65536
          }
        }
      }
    },
    "google": {
      "name": "Google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
