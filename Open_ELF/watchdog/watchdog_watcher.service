[Unit]
Description=ELF Sentinel Watchdog
After=network.target

[Service]
Type=simple
User=bamer
WorkingDirectory=/home/bamer/.opencode/emergent-learning
ExecStart=/usr/bin/python3 /home/bamer/.opencode/emergent-learning/Open_ELF/watchdog/watchdog_sentinel.py
Restart=always
RestartSec=10
StandardOutput=file:/home/bamer/.opencode/emergent-learning/logs/watchdog_sentinel.log
StandardError=file:/home/bamer/.opencode/emergent-learning/logs/watchdog_sentinel_error.log

[Install]
WantedBy=default.target